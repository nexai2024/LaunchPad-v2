# Required: LLM API Key — OpenAI is the standardized AI provider for LaunchPad.
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o

# Pi Agent SDK — provider + model selection for runAgent()/runAgentStream()
# Provider defaults to 'openai' with 'gpt-4o'.
# PI_PROVIDER=openai
# PI_MODEL=gpt-4o

# Task-complexity routing override — optional JSON mapping of task → tier.
# Tiers: cheap (gpt-4o-mini) | balanced (gpt-4o) | premium (o3-mini).
# LLM_ROUTING_JSON={"chat":"premium","monitor-agent":"cheap"}

# REQUIRED for BYOK (Settings > API Keys): AES-256-GCM key for encrypting
# founder-stored API keys at rest. 32 bytes — 64-char hex (openssl rand -hex 32)
# or 44-char base64.
# ENCRYPTION_KEY=

# Optional: Langfuse LLM Observability
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# Optional: Jina API key for web_search + read_url tools (src/lib/pi-tools.ts).
# JINA_API_KEY=jina_...

# Supabase Auth (required for login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase PostgreSQL — required for all data persistence.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Dev-only: which email the backfill script attaches existing projects to.
DEV_USER_EMAIL=dev@launchpad.local

# Monday Brief email (optional).
# RESEND_API_KEY=re_...
# SUPABASE_AUTH_HOOK_SECRET=your_long_random_hex_string
# SENSEFOUND_MAIL_FROM=brief@sensefound.io
# SENSEFOUND_APP_URL=https://app.sensefound.io

# Optional: Firecrawl API for URL-based change detection (src/lib/firecrawl.ts).
# FIRECRAWL_API_KEY=fc-...

# Cron auth — shared secret required by /api/cron.
# CRON_SECRET=your_long_random_hex_string
# WEEKLY_PULSE_DAY=1
